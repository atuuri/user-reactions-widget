{
  "name": "user-reactions",
  "version": "0.1.0",
  "description": "Inline feedback element for AI answers and key product flows.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/user-reactions.mjs",
  "module": "./dist/user-reactions.mjs",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/user-reactions.js",
  "jsdelivr": "./dist/user-reactions.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/user-reactions.mjs"
    },
    "./iife": "./dist/user-reactions.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/size.mjs",
    "size": "node scripts/size.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
